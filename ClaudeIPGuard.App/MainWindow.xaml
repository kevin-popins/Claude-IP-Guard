<Window x:Class="ClaudeIPGuard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude IP Guard"
        Width="980"
        Height="700"
        MinWidth="980"
        MaxWidth="980"
        MinHeight="700"
        MaxHeight="700"
        ResizeMode="NoResize"
        Background="#F3F5F7"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#57606A"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{Binding StatusBrush}" CornerRadius="7" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="6" Background="#22FFFFFF" Padding="4" Margin="0,0,14,0">
                    <Image Source="{Binding StatusLogoPath}" Stretch="Uniform"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" FontSize="23" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding StatusDetail}" FontSize="12" Foreground="White" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open Safely" Command="{Binding OpenClaudeSafelyCommand}" ToolTip="Blocks Claude first, checks the current public IP, unblocks only if safe, then starts Claude Desktop."/>
                    <Button Content="Re-check" Command="{Binding RecheckUnblockCommand}" ToolTip="Turns the firewall block on, checks public IP and country again, and removes the block only after a successful safe decision."/>
                    <Button Content="Kill Claude" Command="{Binding KillClaudeCommand}" Background="#DA3633" Foreground="White" ToolTip="Immediately blocks Claude network access, then terminates Claude Desktop and related child/helper processes."/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" Grid.Row="1" Background="Transparent">
            <TabItem Header="Dashboard">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,10,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Current public IP" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding CurrentIp}" FontSize="34" FontWeight="Bold" FontFamily="Consolas" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Country}" FontSize="21" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Claude status" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding ClaudeStatus}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    <TextBlock FontSize="13" Foreground="#57606A" Margin="0,4,0,0">
                                        <Run Text="Processes: "/>
                                        <Run Text="{Binding ClaudeProcessCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Claude network" Style="{StaticResource Label}"/>
                                    <TextBlock Text="{Binding NetworkAccess}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding FirewallStatus}" FontSize="13" Foreground="#57606A" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="Claude-visible IP" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding ClaudeVisibleIp}" Style="{StaticResource Value}" FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="ASN / provider" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding AsnProvider}" Style="{StaticResource Value}" FontSize="14"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Panel}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Last IP check" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding LastIpCheck}" Style="{StaticResource Value}" FontSize="14"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,10,0" VerticalAlignment="Top">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Claude executable" Style="{StaticResource Label}"/>
                            <TextBlock Grid.Row="1" Text="{Binding ClaudePath}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                            <TextBlock Grid.Row="2" Text="Last decision" Style="{StaticResource Label}"/>
                            <TextBlock Grid.Row="3" Text="{Binding LastDecision}" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Actions" FontSize="17" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <Button Content="Check IP Now" Command="{Binding CheckNowCommand}" Width="270" Margin="0,0,0,6" ToolTip="Runs all public IP providers now and updates country, ASN, decision and dashboard."/>
                                    <Button Content="Block Claude Network" Command="{Binding BlockNetworkCommand}" Width="270" Margin="0,0,0,6" ToolTip="Creates outbound Windows Defender Firewall block rules for every detected Claude executable."/>
                                    <Button Content="Repair Firewall Rules" Command="{Binding RepairFirewallCommand}" Width="270" Margin="0,0,0,6" ToolTip="Deletes and recreates Claude IP Guard firewall rules from the currently detected Claude executable list."/>
                                    <Button Content="Export Diagnostic Report" Command="{Binding ExportReportCommand}" Width="270" Margin="0,0,0,6" ToolTip="Writes a local diagnostic report with app state, IP decision, Claude paths, process status, firewall status and recent logs."/>
                                    <Button Content="Open Logs Folder" Command="{Binding OpenLogsCommand}" Width="270" Margin="0" ToolTip="Opens the local Claude IP Guard logs folder in File Explorer."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="IP providers" FontSize="17" FontWeight="Bold"/>
                                    <ItemsControl ItemsSource="{Binding ProviderReadings}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Panel}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Firewall" FontSize="17" FontWeight="Bold"/>
                                    <ItemsControl ItemsSource="{Binding FirewallRules}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding LastNetworkChange}" FontSize="12" Foreground="#57606A" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Panel}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Claude" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Claude install folders" FontWeight="SemiBold" Margin="0,14,0,0"/>
                                <TextBox Text="{Binding InstallFoldersText, Mode=OneWay}" Height="82" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
                                <TextBlock Text="Claude executable paths" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding PathsText, Mode=OneWay}" Height="112" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
                                <WrapPanel>
                                    <Button Content="Auto-detect Claude installation" Command="{Binding AutoDetectClaudeCommand}" Width="230" HorizontalAlignment="Left" ToolTip="Searches installed AppX/MSIX packages, WindowsApps and user app folders for Claude executables."/>
                                    <Button Content="Choose folder..." Command="{Binding AddClaudeFolderCommand}" Width="150" HorizontalAlignment="Left" ToolTip="Opens File Explorer folder picker and scans the selected folder for Claude executable files."/>
                                    <Button Content="Choose exe..." Command="{Binding AddClaudeExecutableCommand}" Width="130" HorizontalAlignment="Left" ToolTip="Opens File Explorer file picker so you can add a specific Claude executable."/>
                                </WrapPanel>

                                <TextBlock Text="Protection mode" FontSize="20" FontWeight="Bold" Margin="0,16,0,0"/>
                                <ComboBox SelectedValue="{Binding ModeSelection, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Margin="0,8,0,12">
                                    <ComboBoxItem Content="Block countries"/>
                                    <ComboBoxItem Content="IP allowlist"/>
                                </ComboBox>

                                <TextBlock Text="Blocked countries" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding BlockedCountriesText, UpdateSourceTrigger=PropertyChanged}" Height="96" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                                <TextBlock Text="Allowed IPs / CIDRs" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding AllowlistText, UpdateSourceTrigger=PropertyChanged}" Height="116" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="Monitoring" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="IP check interval, seconds" FontWeight="SemiBold" Margin="0,14,0,0"/>
                                <TextBox Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left"/>

                                <CheckBox Content="Strict Mode" IsChecked="{Binding SettingsStrictMode}" ToolTip="When Strict Mode is enabled, Claude-related processes are terminated if a confirmed dangerous country or unsafe allowlist decision is detected."/>
                                <TextBlock Text="Strict Mode kills Claude-related processes only after a confirmed dangerous IP decision. Unknown or changing network states still block network first, but do not auto-kill until danger is confirmed."
                                           Foreground="#57606A"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="22,4,0,6"/>
                                <CheckBox Content="Start with Windows" IsChecked="{Binding SettingsStartWithWindows}"/>
                                <CheckBox Content="Start minimized to tray" IsChecked="{Binding SettingsStartMinimized}"/>
                                <CheckBox Content="Show Windows notifications" IsChecked="{Binding SettingsNotifications}"/>
                                <CheckBox Content="Bring app to front on danger" IsChecked="{Binding SettingsBringToFront}"/>

                                <TextBlock Text="Firewall" FontSize="20" FontWeight="Bold" Margin="0,16,0,0"/>
                                <Button Content="Repair firewall rules" Command="{Binding RepairFirewallCommand}" Width="190" HorizontalAlignment="Left"/>
                                <Button Content="Test firewall block" Command="{Binding TestFirewallCommand}" Width="190" HorizontalAlignment="Left"/>

                                <TextBlock Text="Logs" FontSize="20" FontWeight="Bold" Margin="0,16,0,0"/>
                                <TextBlock Text="{Binding LogFolder}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Open logs folder" Command="{Binding OpenLogsCommand}"/>
                                    <Button Content="Clear logs" Command="{Binding ClearLogsCommand}"/>
                                </StackPanel>

                                <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Width="160" HorizontalAlignment="Left" Margin="0,22,0,0" Background="#0969DA" Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Logs">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open logs folder" Command="{Binding OpenLogsCommand}"/>
                        <Button Content="Export Diagnostic Report" Command="{Binding ExportReportCommand}"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#0D1117" CornerRadius="8" Padding="12">
                        <ListBox ItemsSource="{Binding RecentLogs}" Background="#0D1117" Foreground="#C9D1D9" BorderThickness="0" FontFamily="Consolas"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.RowSpan="2"
                Background="{Binding ToastBrush}"
                CornerRadius="6"
                Padding="14,10"
                MaxWidth="430"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,18,18"
                Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVisibility}}"
                Panel.ZIndex="100">
            <TextBlock Text="{Binding ToastMessage}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
